# LLM provider (only needed for the chat agent and embedding search)
# Option A - OpenAI (api.openai.com)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_ID=gpt-4o-mini

# Option B - Azure OpenAI (set OPENAI_API_TYPE=azure; model names are deployment names)
#OPENAI_API_TYPE=azure
#OPENAI_API_VERSION=2024-02-15-preview
#AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
#AZURE_OPENAI_API_KEY=
#AZURE_COMPLETION_MODEL=gpt-4o
#AZURE_EMBEDDING_MODEL=text-embedding-3-large

# Agent
AGENT_NAME=REALBASKET-ORCHESTRATOR

# Data sources (optional - demo data is used when empty)
DESTATIS_GENESIS_TOKEN=
USE_DEMO_DATA=true

# Local cache (method-note index)
DATA_DIR=data_store

# Method notes of reference PDFs (RAG; context only, never a source of figures)
KNOWLEDGE_DIR=reports/real-data
# bm25 | embedding | auto (embedding if an LLM provider is configured)
KNOWLEDGE_RETRIEVER=auto
EMBEDDING_MODEL_ID=text-embedding-3-small
KNOWLEDGE_TOP_K=4
