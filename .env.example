# LLM provider
OPENAI_API_KEY=sk-...
OPENAI_MODEL_ID=gpt-4o-mini

# Agent
AGENT_NAME=REALBASKET-ORCHESTRATOR

# Data sources (optional - demo data is used when empty)
DESTATIS_GENESIS_TOKEN=
USE_DEMO_DATA=true

# Non-deterministic monitoring flow (guardrails)
AGENT_NAME_PREFIX=REALBASKET
FLOW_TEMPERATURE=0.3
DATA_DIR=data_store
MAX_SOURCE_ATTEMPTS=3
MAX_INVESTIGATION_STEPS=4
MAX_REPLANS=1
MAX_NODE_EXECUTIONS=30
RUN_TIMEOUT_S=900
DEVIATION_THRESHOLD_PP=1.0
CONFIDENCE_THRESHOLD=0.7
# Demo only: probability that a primary demo source delivers faulty data (0 = clean)
DEMO_FAULT_RATE=0.35
#DEMO_FAULT_SEED=42
